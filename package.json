{
  "name": "self-correcting-integration-maintainer",
  "version": "0.0.1",
  "private": true,
  "description": "A TrueForge agent that repairs an unexpected integration-contract change without self-authorizing its consequences.",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "trueforge": "trueforge --port 8790",
    "verify:prereqs": "node scripts/verify-prereqs.mjs",
    "smoke:trueforge": "node scripts/smoke-trueforge.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.1.3"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "0.1.4"
  },
  "license": "MIT"
}
