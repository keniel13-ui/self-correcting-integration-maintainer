{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keniel13-ui/self-correcting-integration-maintainer/blob/main/docs/contracts/change-proposal-v2.schema.json",
  "title": "ChangeProposal v2",
  "description": "A sandbox-verified exact-byte replacement that remains structurally pending human approval. This schema cannot represent an applied change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "finding_id",
    "corpus_manifest_sha256",
    "target",
    "change",
    "verification",
    "authority",
    "not_established"
  ],
  "properties": {
    "schema": { "const": "change_proposal/v2" },
    "proposal_id": { "type": "string", "pattern": "^CP-[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "finding_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "original_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "original_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "before_exact", "after_exact", "resulting_file_sha256"],
      "properties": {
        "operation": { "const": "REPLACE_EXACT_BYTES" },
        "before_exact": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "after_exact": { "type": "string", "maxLength": 32768 },
        "resulting_file_sha256": {
          "description": "SHA-256 of the complete target file after the one exact replacement.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "execution_evidence_sha256",
        "command_manifest_sha256",
        "exit_code",
        "candidate_stdout_sha256"
      ],
      "properties": {
        "status": { "const": "VERIFIED_IN_DAYTONA" },
        "execution_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "command_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "exit_code": { "const": 0 },
        "candidate_stdout_sha256": {
          "description": "SHA-256 of stdout produced by the corpus verification command.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approval_required", "apply_capability_exposed_to_agent", "applied"],
      "properties": {
        "state": { "const": "AWAITING_HUMAN_APPROVAL" },
        "approval_required": { "const": true },
        "apply_capability_exposed_to_agent": { "const": false },
        "applied": { "const": false }
      }
    },
    "not_established": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
